<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="EdgePanel.Pages.AiPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="14" Spacing="10">

            <!--  用量总览放在最前  -->
            <TextBlock Text="AI 用量总览" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="10">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="RunningCount" Style="{StaticResource MetricValue}" Text="0" />
                            <TextBlock Style="{StaticResource MetricLabel}" Text="运行中" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="TodaySessions" Style="{StaticResource MetricValue}" Text="0" />
                            <TextBlock Style="{StaticResource MetricLabel}" Text="今日记录" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock x:Name="TodayTokens" Style="{StaticResource MetricValue}" Text="0" />
                            <TextBlock Style="{StaticResource MetricLabel}" Text="今日 Token" />
                        </StackPanel>
                        <StackPanel Grid.Column="3">
                            <TextBlock x:Name="TotalTokens" Style="{StaticResource MetricValue}" Text="0" />
                            <TextBlock Style="{StaticResource MetricLabel}" Text="累计 Token" />
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="QuotaText" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <TextBlock Text="各工具用量" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource Card}">
                <StackPanel x:Name="UsagePanel" Spacing="8" />
            </Border>

            <TextBlock Text="Agent 工作区" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource Card}">
                <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="WorkspacePanel" Spacing="6" />
                </ScrollViewer>
            </Border>

            <Button Click="Refresh_Click" Content="刷新" Style="{StaticResource AccentButtonStyle}" />

            <TextBlock
                FontSize="11"
                Opacity="0.6"
                Text="说明：Token 用量从本机会话 JSONL 里尽力统计；Cursor / Windsurf / Copilot 等把额度存在账号侧或 SQLite 中，本地只能显示是否安装与运行状态。"
                TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
