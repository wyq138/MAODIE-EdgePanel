<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="EdgePanel.Pages.SystemPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="14" Spacing="12">

            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="10">
                    <TextBlock Text="实时负载" Style="{StaticResource SectionTitle}" />
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="CpuText" Style="{StaticResource MetricValue}" Text="0%" />
                            <TextBlock Style="{StaticResource MetricLabel}" Text="CPU" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="MemText" Style="{StaticResource MetricValue}" Text="0G" />
                            <TextBlock Style="{StaticResource MetricLabel}" Text="内存" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock x:Name="NetText" Style="{StaticResource MetricValue}" Text="0" />
                            <TextBlock Style="{StaticResource MetricLabel}" Text="KB/s 下载" />
                        </StackPanel>
                    </Grid>
                    <ProgressBar x:Name="CpuBar" Maximum="100" />
                    <ProgressBar x:Name="MemBar" Maximum="100" />
                    <TextBlock
                        x:Name="InfoText"
                        FontSize="11"
                        Opacity="0.6"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <TextBlock Text="磁盘空间" Style="{StaticResource SectionTitle}" />
            <StackPanel x:Name="DiskPanel" Spacing="8" />

            <TextBlock Text="内存占用最高的进程" Style="{StaticResource SectionTitle}" />
            <StackPanel x:Name="ProcessPanel" Spacing="6" />
        </StackPanel>
    </ScrollViewer>
</Page>