<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="EdgePanel.Pages.WeatherPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="14" Spacing="12">

            <Border Style="{StaticResource Card}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="NowGlyph"
                        Margin="4,0,8,0"
                        VerticalAlignment="Center"
                        FontFamily="Segoe UI Emoji"
                        FontSize="38"
                        Text="&#x2600;&#xFE0F;" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="NowTemp" FontSize="34" FontWeight="SemiBold" Text="--°" />
                        <TextBlock x:Name="NowDesc" Opacity="0.75" Text="等待获取…" />
                        <TextBlock
                            x:Name="NowDetail"
                            FontSize="11"
                            Opacity="0.6"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <Button
                        Grid.Column="2"
                        VerticalAlignment="Top"
                        Click="Refresh_Click">
                        <FontIcon FontSize="14" Glyph="&#xE72C;" />
                    </Button>
                </Grid>
            </Border>

            <TextBlock Text="未来 7 天" Style="{StaticResource SectionTitle}" />
            <StackPanel x:Name="ForecastPanel" Spacing="6" />

            <TextBlock Text="定位设置" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="10">
                    <TextBox x:Name="PlaceBox" Header="地点名称" PlaceholderText="例如：北京" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <NumberBox
                            x:Name="LatBox"
                            Grid.Column="0"
                            Header="纬度"
                            SmallChange="0.01"
                            SpinButtonPlacementMode="Compact" />
                        <NumberBox
                            x:Name="LonBox"
                            Grid.Column="1"
                            Header="经度"
                            SmallChange="0.01"
                            SpinButtonPlacementMode="Compact" />
                    </Grid>
                    <Button
                        Click="SaveLocation_Click"
                        Content="保存并刷新"
                        Style="{StaticResource AccentButtonStyle}" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            Click="ScanPick_Click"
                            Content="手机扫码选点" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="11"
                            Opacity="0.6"
                            Text="用手机扫二维码，在地图上点选后坐标自动回传电脑" />
                    </StackPanel>

                    <Border
                        x:Name="QrPanel"
                        Visibility="Collapsed"
                        Background="#12000000"
                        CornerRadius="10"
                        Padding="12">
                        <StackPanel Spacing="8">
                            <TextBlock
                                FontWeight="SemiBold"
                                Text="手机扫码选点（需与电脑在同一 WiFi）" />
                            <Image
                                x:Name="QrImage"
                                Width="200"
                                Height="200"
                                HorizontalAlignment="Center" />
                            <TextBlock
                                x:Name="QrStatus"
                                FontSize="12"
                                TextWrapping="Wrap" />
                            <TextBlock
                                x:Name="QrUrlText"
                                FontSize="11"
                                Opacity="0.6"
                                TextWrapping="Wrap" />
                            <Button Click="StopScanPick_Click" Content="关闭扫码" />
                        </StackPanel>
                    </Border>

                    <TextBlock
                        FontSize="11"
                        Opacity="0.55"
                        Text="数据来源 Open-Meteo（免密钥）。修改经纬度后点「保存并刷新」即可切换城市。"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>