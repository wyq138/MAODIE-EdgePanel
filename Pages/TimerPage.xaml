<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="EdgePanel.Pages.TimerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="14" Spacing="14">

            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="10">
                    <TextBlock Text="秒表" Style="{StaticResource SectionTitle}" />
                    <TextBlock
                        x:Name="StopwatchText"
                        FontSize="36"
                        FontWeight="SemiBold"
                        Text="00:00.00" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            x:Name="SwStartButton"
                            Click="SwToggle_Click"
                            Content="开始"
                            Style="{StaticResource AccentButtonStyle}" />
                        <Button Click="Lap_Click" Content="计次" />
                        <Button Click="SwReset_Click" Content="重置" />
                    </StackPanel>
                    <StackPanel x:Name="LapPanel" Spacing="4" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="10">
                    <TextBlock Text="倒计时" Style="{StaticResource SectionTitle}" />
                    <TextBlock
                        x:Name="CountdownText"
                        FontSize="36"
                        FontWeight="SemiBold"
                        Text="05:00" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <NumberBox
                            x:Name="MinutesBox"
                            Width="110"
                            Maximum="180"
                            Minimum="1"
                            SpinButtonPlacementMode="Compact"
                            Value="5" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Opacity="0.7"
                            Text="分钟" />
                        <Button
                            x:Name="CdStartButton"
                            Click="CdToggle_Click"
                            Content="开始" />
                        <Button Click="CdReset_Click" Content="重置" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>