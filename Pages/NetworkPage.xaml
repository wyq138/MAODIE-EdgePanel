<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="EdgePanel.Pages.NetworkPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="14" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="网络适配器" Style="{StaticResource SectionTitle}" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="AdapterPanel" Spacing="8" />
        </ScrollViewer>

        <StackPanel
            Grid.Row="2"
            Orientation="Horizontal"
            Spacing="8">
            <Button Click="Refresh_Click" Content="刷新" Style="{StaticResource AccentButtonStyle}" />
            <Button Click="OpenSettings_Click" Content="网络设置" />
            <Button Click="IpConfig_Click" Content="ipconfig" />
            <Button Click="OpenConnections_Click" Content="网络连接" />
        </StackPanel>
    </Grid>
</Page>