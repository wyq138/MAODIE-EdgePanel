<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="EdgePanel.Pages.ToolsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="14" Spacing="12">

            <TextBlock Text="系统操作" Style="{StaticResource SectionTitle}" />
            <Grid x:Name="ActionGrid" ColumnSpacing="8" RowSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
            </Grid>

            <TextBlock Text="自定义命令" Style="{StaticResource SectionTitle}" />
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="CommandBox"
                    Grid.Column="0"
                    KeyDown="CommandBox_KeyDown"
                    PlaceholderText="例如 notepad / ipconfig / calc" />
                <Button
                    Grid.Column="1"
                    Click="Run_Click"
                    Content="运行" />
            </Grid>

            <TextBlock
                FontSize="11"
                Opacity="0.6"
                Text="提示：关机 / 重启会立即执行，请先保存好其它工作。"
                TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>