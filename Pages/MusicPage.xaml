<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="EdgePanel.Pages.MusicPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:EdgePanel.Controls">

    <Grid Margin="14" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  曲目信息  -->
        <Border Grid.Row="0" Style="{StaticResource Card}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    Width="64"
                    Height="64"
                    Background="#26000000"
                    CornerRadius="10">
                    <Grid>
                        <FontIcon FontSize="26" Glyph="&#xE8D6;" Opacity="0.5" />
                        <Image x:Name="CoverImage" Stretch="UniformToFill" />
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <controls:MarqueeText
                        x:Name="TitleMarquee"
                        FontSize="16"
                        Speed="60" />
                    <TextBlock
                        x:Name="ArtistText"
                        Margin="0,2,0,0"
                        Opacity="0.7"
                        Text="未检测到播放中的媒体" />
                </StackPanel>
            </Grid>
        </Border>

        <!--  进度  -->
        <StackPanel Grid.Row="1" Spacing="2">
            <Slider x:Name="ProgressSlider" ValueChanged="ProgressSlider_ValueChanged" />
            <Grid>
                <TextBlock x:Name="PositionText" FontSize="11" Opacity="0.7" Text="00:00" />
                <TextBlock
                    x:Name="DurationText"
                    HorizontalAlignment="Right"
                    FontSize="11"
                    Opacity="0.7"
                    Text="00:00" />
            </Grid>
        </StackPanel>

        <!--  控制按钮  -->
        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button
                Grid.Column="0"
                HorizontalAlignment="Stretch"
                Click="Prev_Click">
                <FontIcon FontSize="16" Glyph="&#xE892;" />
            </Button>
            <Button
                x:Name="PlayButton"
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                Click="Play_Click">
                <FontIcon FontSize="18" Glyph="&#xE768;" />
            </Button>
            <Button
                Grid.Column="2"
                HorizontalAlignment="Stretch"
                Click="Next_Click">
                <FontIcon FontSize="16" Glyph="&#xE893;" />
            </Button>
        </Grid>

        <!--  歌词  -->
        <Border
            Grid.Row="3"
            Padding="4"
            Style="{StaticResource Card}">
            <Grid>
                <ScrollViewer x:Name="LyricScroll" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="LyricPanel" Padding="6,40" Spacing="10" />
                </ScrollViewer>
                <TextBlock
                    x:Name="LyricEmpty"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Opacity="0.55"
                    Text="暂无歌词&#x0a;已按歌名自动匹配：本地 .lrc → 网易云 → LRCLIB&#x0a;仍为空说明这几个曲库里都没有这首"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </Grid>
        </Border>

        <!--  底部操作  -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8">
            <Button Click="ReloadLyrics_Click" Content="重新匹配歌词" />
            <Button Click="PickFolder_Click" Content="选择歌词目录" />
        </StackPanel>
    </Grid>
</Page>