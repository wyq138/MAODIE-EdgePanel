<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="EdgePanel.Pages.NotesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="14" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <TextBlock Text="便签 · 自动保存" Style="{StaticResource SectionTitle}" />
            <TextBlock
                x:Name="StatusText"
                HorizontalAlignment="Right"
                FontSize="11"
                Opacity="0.6" />
        </Grid>

        <StackPanel
            Grid.Row="1"
            Orientation="Horizontal"
            Spacing="8">
            <Button Click="InsertTime_Click" Content="插入时间" />
            <Button Click="Clear_Click" Content="清空" />
            <Button Click="OpenFolder_Click" Content="打开数据目录" />
        </StackPanel>

        <TextBox
            x:Name="Editor"
            Grid.Row="2"
            AcceptsReturn="True"
            PlaceholderText="随手记点什么……鼠标离开页面会自动保存"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            TextChanged="Editor_TextChanged"
            TextWrapping="Wrap" />

        <Button
            Grid.Row="3"
            HorizontalAlignment="Right"
            Click="Save_Click"
            Content="立即保存"
            Style="{StaticResource AccentButtonStyle}" />
    </Grid>
</Page>