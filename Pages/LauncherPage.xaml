<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="EdgePanel.Pages.LauncherPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:EdgePanel.Pages">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="14" Spacing="10">

            <TextBlock Text="常用应用（本机已安装 · 点击即启动）" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBox
                        x:Name="AppSearchBox"
                        PlaceholderText="搜索本机已安装的应用"
                        TextChanged="AppSearch_TextChanged" />

                    <StackPanel
                        Grid.Row="1"
                        Margin="0,8,0,0"
                        Spacing="6">
                        <TextBlock
                            x:Name="AppCountText"
                            FontSize="11"
                            Opacity="0.6"
                            Text="正在扫描本机应用…" />
                        <ProgressRing
                            x:Name="AppScanRing"
                            Width="24"
                            Height="24"
                            HorizontalAlignment="Left"
                            IsActive="False"
                            Visibility="Collapsed" />
                        <ListView
                            x:Name="AppList"
                            MaxHeight="360"
                            IsItemClickEnabled="True"
                            ItemClick="AppList_ItemClick"
                            SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:AppRow">
                                    <StackPanel
                                        Padding="2,3"
                                        Orientation="Horizontal"
                                        Spacing="8">
                                        <Grid Width="22" Height="22">
                                            <FontIcon
                                                FontSize="13"
                                                Glyph="&#xE7B8;"
                                                Opacity="0.55" />
                                            <Image Source="{x:Bind Icon}" Stretch="Uniform" />
                                        </Grid>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="13"
                                            Text="{x:Bind Name}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="系统工具（Windows 自带）" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource Card}">
                <Grid x:Name="CommonGrid" ColumnSpacing="6" RowSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                </Grid>
            </Border>

            <TextBlock Text="添加自定义快捷项" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="8">
                    <TextBox
                        x:Name="TargetBox"
                        Header="目标路径 / 网址 / 命令"
                        PlaceholderText="C:\Windows\notepad.exe  或  https://example.com" />
                    <TextBox
                        x:Name="NameBox"
                        Header="显示名称（可留空）"
                        PlaceholderText="记事本" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            Click="Add_Click"
                            Content="添加"
                            Style="{StaticResource AccentButtonStyle}" />
                        <Button Click="PickFile_Click" Content="选择文件" />
                        <Button Click="PickFolder_Click" Content="选择文件夹" />
                    </StackPanel>
                    <TextBlock
                        FontSize="11"
                        Opacity="0.6"
                        Text="提示：以 cmd: 开头的内容会当作命令执行，例如 cmd:shutdown /s /t 60"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <TextBlock Text="已添加快捷项" Style="{StaticResource SectionTitle}" />
            <StackPanel x:Name="ListPanel" Spacing="8" />
        </StackPanel>
    </ScrollViewer>
</Page>
